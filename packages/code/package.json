{
  "name": "@fieldwork-ai/fieldwork-code",
  "version": "0.19.0",
  "description": "Fieldwork Code: terminal chat with built-in local tools",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "bin": {
    "fwcode": "dist/code.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc",
    "prepack": "pnpm build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:tui": "vitest run tests/tui.test.ts tests/tui-pty.test.ts",
    "tui:demo": "tsx tests/tui/demo.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@fieldwork-ai/codex-transport": "0.1.3",
    "ai": "^7.0.93",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@xterm/headless": "6.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fieldwork-ai/fieldwork-code.git",
    "directory": "packages/code"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./dist/*.js"
  }
}
